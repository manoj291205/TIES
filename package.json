{
  "name": "ties",
  "version": "0.1.0",
  "private": true,
  "description": "Parametric flight-delay and weather insurance DApp with interval-indexed settlement",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "lint": "npm run lint:sol && npm run lint:ts && npm run format:check",
    "lint:sol": "node scripts/lint-sol.mjs",
    "lint:ts": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "hardhat test && npm run test --workspaces --if-present",
    "build": "hardhat compile && npm run typecheck && npm run build --workspaces --if-present",
    "coverage": "hardhat coverage",
    "typecheck": "tsc --noEmit -p tsconfig.services.json",
    "node:local": "hardhat node",
    "deploy:local": "node -r ts-node/register/transpile-only scripts/deploy.ts",
    "seed:local": "node -r ts-node/register/transpile-only scripts/seed.ts",
    "export-abi": "node -r ts-node/register/transpile-only scripts/export-abi.ts",
    "stack:init": "node -r ts-node/register/transpile-only scripts/deploy-and-seed.ts",
    "stack:sources": "node -r ts-node/register/transpile-only services/sources/src/main.ts",
    "stack:oracles": "node -r ts-node/register/transpile-only services/oracle-node/src/main.ts",
    "stack:keeper": "node -r ts-node/register/transpile-only services/keeper/src/main.ts",
    "stack:demo-server": "node -r ts-node/register/transpile-only services/demo-server/src/main.ts",
    "dev:stack": "hardhat compile && concurrently --kill-others-on-fail -n node,init,sources,oracles,keeper,demo -c gray,yellow,cyan,magenta,green,blue \"npm run node:local\" \"npm run stack:init\" \"npm run stack:sources\" \"npm run stack:oracles\" \"npm run stack:keeper\" \"npm run stack:demo-server\"",
    "demo:cli": "node -r ts-node/register/transpile-only scripts/demo-cli.ts",
    "dev:web": "npm -w frontend run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@nomicfoundation/hardhat-ignition": "0.15.8",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.8",
    "@nomicfoundation/hardhat-network-helpers": "1.0.12",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "2.0.12",
    "@nomicfoundation/ignition-core": "0.15.8",
    "@openzeppelin/contracts": "^5.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "ethers": "^6.13.4",
    "hardhat": "2.22.17",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.2",
    "solhint": "^5.0.4",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
